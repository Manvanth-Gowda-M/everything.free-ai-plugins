{
  "name": "everything.free-ai-plugins",
  "version": "0.1.0",
  "description": "Open-source, 100% free AI capability platform and MCP server for ChatGPT and AI assistants.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "everything-free": "./dist/server.js",
    "everything-free-ai-plugins": "./dist/server.js",
    "everything.free-ai-plugins": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everything-free-by-Quilonix/everything.free-ai-plugins.git"
  },
  "homepage": "https://github.com/everything-free-by-Quilonix/everything.free-ai-plugins#readme",
  "bugs": {
    "url": "https://github.com/everything-free-by-Quilonix/everything.free-ai-plugins/issues"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "vite build web --outDir ../dist-web --emptyOutDir",
    "build:all": "npm run build && npm run build:web",
    "dev": "tsx watch src/server.ts",
    "dev:stdio": "tsx src/server.ts --stdio",
    "dev:web": "vite web",
    "preview:web": "vite preview web --outDir ../dist-web",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio",
    "benchmark": "tsx src/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --project web/tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"web/src/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "claude",
    "gemini",
    "ai-plugin",
    "free-ai",
    "tools",
    "quilonix"
  ],
  "author": "Quilonix",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
